<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="heart.mapper.MyLTMapper">
	<select id="findLT" resultType="heart.model.HeartRate">
		SELECT "LT_HeartRate", "CURRENT DATE"
		FROM "LT_HeartRate"
		WHERE "LT_HeartRate"."id" = #{id,jdbcType=VARCHAR}
	</select>


</mapper>